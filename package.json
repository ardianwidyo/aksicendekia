{
  "name": "aksicendekia-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter \"@aksicendekia/*\" build && pnpm --filter web build",
    "deploy": "pnpm build && npx wrangler pages deploy apps/web/out --project-name=aksicendekia",
    "build:pages": "pnpm --filter \"@aksicendekia/*\" build && pnpm --filter web pages:build",
    "build:tokens": "pnpm --filter @aksicendekia/design-tokens build",
    "lint": "pnpm --filter \"*\" lint",
    "test": "pnpm --filter \"*\" test",
    "verify:video-embeds": "tsx scripts/verify-video-embeds.ts"
  },
  "devDependencies": {
    "@aksicendekia/content-kit": "workspace:*",
    "tsx": "^4.23.0",
    "typescript": "^5.4.0"
  }
}

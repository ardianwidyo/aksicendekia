datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SISWA
  ORANG_TUA
  GURU
  ADMIN
}

enum AccountStatus {
  PENDING_CONSENT
  ACTIVE
  SUSPENDED
}

enum EducationStage {
  TK
  SD
  SMP
  SMA
}

enum VerificationMethod {
  EMAIL_LINK
  OTP_CODE
  DIRECT_PARENT_DASHBOARD
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  studentProfile      StudentProfile?
  parentLinks         ParentChildLink[]       @relation("ParentLinks")
  parentalConsents    ParentalConsent[]
  taughtClasses       Class[]                 @relation("TaughtClasses")
  refreshTokens       RefreshToken[]
  learningSessions    LearningSession[]
  studentProgress     StudentProgress?
  xpTransactions      XpTransaction[]
  studentBadges          StudentBadge[]
  studentPowerups        StudentPowerup[]
  powerupTransactions    PowerupTransaction[]
  studentDailyChallenges StudentDailyChallenge[]
  studentPrivacySetting  StudentPrivacySetting?
  parentalControlSettingAsStudent ParentalControlSetting?   @relation("StudentParentalSettings")
  parentalControlSettingsAsParent ParentalControlSetting[]  @relation("ParentConfiguredSettings")
  taughtAssignments              LessonAssignment[]
  studentAssignmentProgresses    StudentAssignmentProgress[]
  userWeeklyReports              WeeklyReportSummary[]      @relation("UserWeeklyReports")
  studentWeeklyReports           WeeklyReportSummary[]      @relation("StudentWeeklyReports")
  accessorLogs                   StudentDataAccessLog[]     @relation("LogAccessorUser")
  targetStudentLogs              StudentDataAccessLog[]     @relation("LogTargetStudent")

  @@map("users")
}

model StudentProfile {
  id             String         @id @default(uuid())
  userId         String         @unique @map("user_id")
  displayName    String         @map("display_name")
  educationStage EducationStage @map("education_stage")
  gradeLevel     Int            @map("grade_level")
  avatarId       String         @map("avatar_id")
  birthDate      DateTime       @map("birth_date")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks      ParentChildLink[]
  classEnrollments ClassEnrollment[]
  lessonProgress   StudentLessonProgress[]

  @@map("student_profiles")
}

model ParentChildLink {
  id               String   @id @default(uuid())
  parentId         String   @map("parent_id")
  studentProfileId String   @map("student_profile_id")
  createdAt        DateTime @default(now()) @map("created_at")

  parent         User            @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  consent        ParentalConsent?

  @@unique([parentId, studentProfileId])
  @@map("parent_child_links")
}

model ParentalConsent {
  id                 String             @id @default(uuid())
  linkId             String             @unique @map("link_id")
  parentUserId       String             @map("parent_user_id")
  consentedAt        DateTime           @default(now()) @map("consented_at")
  verificationMethod VerificationMethod @map("verification_method")
  consentVersion     String             @default("v1.0") @map("consent_version")

  link       ParentChildLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  parentUser User            @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  @@map("parental_consents")
}

model Class {
  id             String         @id @default(uuid())
  teacherId      String         @map("teacher_id")
  name           String
  educationStage EducationStage @map("education_stage")
  classCode      String         @unique @map("class_code")
  createdAt      DateTime       @default(now()) @map("created_at")

  teacher     User              @relation("TaughtClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments ClassEnrollment[]
  assignments LessonAssignment[]

  @@map("classes")
}

model ClassEnrollment {
  id               String   @id @default(uuid())
  classId          String   @map("class_id")
  studentProfileId String   @map("student_profile_id")
  enrolledAt       DateTime @default(now()) @map("enrolled_at")

  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([classId, studentProfileId])
  @@map("class_enrollments")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum CurriculumPhase {
  FOUNDATION
  FASE_A
  FASE_B
  FASE_C
  FASE_D
  FASE_E
  FASE_F
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  MATCHING_PAIRS
}

enum MatchingMode {
  EXACT
  CASE_INSENSITIVE
  NORMALIZED
}

model Subject {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  educationStage EducationStage  @map("education_stage")
  phase          CurriculumPhase
  status         ContentStatus   @default(DRAFT)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  units Unit[]

  @@map("subjects")
}

model Unit {
  id          String        @id @default(uuid())
  subjectId   String        @map("subject_id")
  title       String
  description String?
  orderIndex  Int           @map("order_index")
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("units")
}

model Lesson {
  id                       String          @id @default(uuid())
  unitId                   String          @map("unit_id")
  title                    String
  summary                  String
  learningObjective        String          @map("learning_objective")
  educationStage           EducationStage  @map("education_stage")
  phase                    CurriculumPhase
  difficultyLevel          DifficultyLevel @map("difficulty_level")
  estimatedDurationMinutes Int             @map("estimated_duration_minutes")
  orderIndex               Int             @map("order_index")
  status                   ContentStatus   @default(DRAFT)
  version                  Int             @default(1)
  parentVersionId          String?         @map("parent_version_id")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")

  unit            Unit                    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  parentVersion   Lesson?                 @relation("LessonVersions", fields: [parentVersionId], references: [id], onDelete: SetNull)
  childVersions   Lesson[]                @relation("LessonVersions")
  questionItems   QuestionItem[]
  prerequisites   LessonPrerequisite[]    @relation("LessonRequired")
  isRequiredBy    LessonPrerequisite[]    @relation("PrerequisiteLesson")
  studentProgress StudentLessonProgress[]
  learningSessions LearningSession[]
  assignments      LessonAssignment[]

  @@map("lessons")
}

model LessonPrerequisite {
  lessonId             String @map("lesson_id")
  prerequisiteLessonId String @map("prerequisite_lesson_id")

  lesson             Lesson @relation("LessonRequired", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisiteLesson Lesson @relation("PrerequisiteLesson", fields: [prerequisiteLessonId], references: [id], onDelete: Cascade)

  @@id([lessonId, prerequisiteLessonId])
  @@map("lesson_prerequisites")
}

model QuestionItem {
  id             String        @id @default(uuid())
  lessonId       String        @map("lesson_id")
  questionType   QuestionType  @map("question_type")
  promptText     String        @map("prompt_text")
  contentPayload Json          @map("content_payload")
  explanation    String
  orderIndex     Int           @map("order_index")
  status         ContentStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  lesson Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  hints  QuestionHint[]
  sessionOrders SessionQuestionOrder[]
  sessionAnswers SessionAnswer[]

  @@map("question_items")
}

model QuestionHint {
  id             String   @id @default(uuid())
  questionItemId String   @map("question_item_id")
  stepOrder      Int      @map("step_order")
  hintText       String   @map("hint_text")
  createdAt      DateTime @default(now()) @map("created_at")

  questionItem QuestionItem @relation(fields: [questionItemId], references: [id], onDelete: Cascade)

  @@unique([questionItemId, stepOrder])
  @@map("question_hints")
}

enum ProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  COMPLETED
}

model StudentLessonProgress {
  id               String         @id @default(uuid())
  studentProfileId String         @map("student_profile_id")
  lessonId         String         @map("lesson_id")
  status           ProgressStatus @default(LOCKED)
  isCompleted      Boolean        @default(false) @map("is_completed")
  bestScore        Decimal?       @db.Decimal(5, 2) @map("best_score")
  attemptsCount    Int            @default(0) @map("attempts_count")
  completedAt      DateTime?      @map("completed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, lessonId])
  @@map("student_lesson_progress")
}

enum SessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  EXPIRED
}

model LearningSession {
  id               String                 @id @default(uuid())
  studentId        String                 @map("student_id")
  lessonId         String                 @map("lesson_id")
  status           SessionStatus          @default(IN_PROGRESS)
  currentIndex     Int                    @default(0) @map("current_index")
  totalQuestions   Int                    @map("total_questions")
  correctCount     Int                    @default(0) @map("correct_count")
  incorrectCount   Int                    @default(0) @map("incorrect_count")
  score            Decimal?               @db.Decimal(5, 2)
  durationSeconds  Int                    @default(0) @map("duration_seconds")
  startedAt        DateTime               @default(now()) @map("started_at")
  lastActivityAt   DateTime               @default(now()) @map("last_activity_at")
  expiresAt        DateTime               @map("expires_at")
  completedAt      DateTime?              @map("completed_at")

  questionOrders   SessionQuestionOrder[]
  answers          SessionAnswer[]
  outboxEvents     OutboxEvent[]

  student          User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson           Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([studentId, status])
  @@index([expiresAt, status])
  @@map("learning_sessions")
}

model SessionQuestionOrder {
  id            String          @id @default(uuid())
  sessionId     String          @map("session_id")
  questionId    String          @map("question_id")
  sequenceOrder Int             @map("sequence_order")

  session       LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question      QuestionItem    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, sequenceOrder])
  @@map("session_question_orders")
}

model SessionAnswer {
  id              String          @id @default(uuid())
  sessionId       String          @map("session_id")
  questionId      String          @map("question_id")
  studentAnswer   Json            @map("student_answer")
  isCorrect       Boolean         @map("is_correct")
  hintUsedCount   Int             @default(0) @map("hint_used_count")
  timeSpentSec    Int             @default(0) @map("time_spent_sec")
  idempotencyKey  String          @unique @map("idempotency_key")
  submittedAt     DateTime        @default(now()) @map("submitted_at")

  session         LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question        QuestionItem    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@map("session_answers")
}

model OutboxEvent {
  id            String           @id @default(uuid())
  aggregateType String           @map("aggregate_type")
  aggregateId   String           @map("aggregate_id")
  eventType     String           @map("event_type")
  payload       Json
  published     Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at")
  publishedAt   DateTime?        @map("published_at")

  session       LearningSession? @relation(fields: [aggregateId], references: [id], onDelete: Cascade)

  @@index([published, createdAt])
  @@map("outbox_events")
}

enum PowerupType {
  HINT_TOKEN
  STREAK_FREEZE
}

enum PowerupAction {
  EARNED
  CONSUMED
}

enum XpSourceType {
  QUESTION_CORRECT
  LESSON_BONUS
  PERFECT_SCORE_BONUS
  MILESTONE_BONUS
  DAILY_CHALLENGE_BONUS
}

enum BadgeCategory {
  LESSON_MILESTONE
  STREAK_MILESTONE
  ACCURACY_MASTER
  SUBJECT_MASTER
}

model StudentProgress {
  id             String   @id @default(uuid())
  studentId      String   @unique @map("student_id")
  totalXp        Int      @default(0) @map("total_xp")
  level          Int      @default(1)
  currentStreak  Int      @default(0) @map("current_streak")
  longestStreak  Int      @default(0) @map("longest_streak")
  lastActiveDate String?  @map("last_active_date")
  timezone       String   @default("Asia/Jakarta")

  updatedAt      DateTime @updatedAt @map("updated_at")

  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_progress")
}

model XpTransaction {
  id          String       @id @default(uuid())
  studentId   String       @map("student_id")
  amount      Int
  source      XpSourceType
  referenceId String?      @map("reference_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("xp_transactions")
}

model BadgeDefinition {
  id                 String         @id @default(uuid())
  code               String         @unique
  name               String
  description        String
  iconUrl            String         @map("icon_url")
  category           BadgeCategory
  conditionType      String         @map("condition_type")
  conditionParameter Json           @map("condition_parameter")

  createdAt          DateTime       @default(now()) @map("created_at")
  studentBadges      StudentBadge[]

  @@map("badge_definitions")
}

model StudentBadge {
  id             String          @id @default(uuid())
  studentId      String          @map("student_id")
  badgeId        String          @map("badge_id")
  triggerEventId String?         @map("trigger_event_id")
  unlockedAt     DateTime        @default(now()) @map("unlocked_at")

  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge          BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([studentId, badgeId])
  @@index([studentId])
  @@map("student_badges")
}

model StudentPowerup {
  id          String      @id @default(uuid())
  studentId   String      @map("student_id")
  powerupType PowerupType @map("powerup_type")
  quantity    Int         @default(0)
  updatedAt   DateTime    @updatedAt @map("updated_at")

  student     User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, powerupType])
  @@index([studentId])
  @@map("student_powerups")
}

model PowerupTransaction {
  id          String        @id @default(uuid())
  studentId   String        @map("student_id")
  powerupType PowerupType   @map("powerup_type")
  actionType  PowerupAction @map("action_type")
  amount      Int
  source      String
  referenceId String?       @map("reference_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@map("powerup_transactions")
}

model ProcessedEventLog {
  eventId     String   @id @map("event_id")
  eventType   String   @map("event_type")
  aggregateId String   @map("aggregate_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_event_logs")
}

// ==========================================
// Daily Challenge & Privacy Setting Models
// ==========================================

enum ChallengeTargetType {
  QUESTION_COUNT
  LESSON_COUNT
  ACCURACY_TARGET
}

enum ChallengeStatus {
  IN_PROGRESS
  COMPLETED
  CLAIMED
  EXPIRED
}

model DailyChallenge {
  id                String              @id @default(uuid())
  educationStage    EducationStage      @map("education_stage")
  challengeDate     DateTime            @db.Date @map("challenge_date")
  title             String
  description       String
  targetType        ChallengeTargetType @map("target_type")
  targetValue       Int                 @map("target_value")
  rewardXp          Int                 @default(50) @map("reward_xp")
  rewardPowerupType PowerupType?        @map("reward_powerup_type")
  rewardPowerupQty  Int                 @default(0) @map("reward_powerup_qty")
  createdAt         DateTime            @default(now()) @map("created_at")

  studentProgresses StudentDailyChallenge[]

  @@unique([educationStage, challengeDate])
  @@map("daily_challenges")
}

model StudentDailyChallenge {
  id               String          @id @default(uuid())
  studentUserId    String          @map("student_user_id")
  dailyChallengeId String          @map("daily_challenge_id")
  currentProgress  Int             @default(0) @map("current_progress")
  status           ChallengeStatus @default(IN_PROGRESS)
  completedAt      DateTime?       @map("completed_at")
  claimedAt        DateTime?       @map("claimed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  studentUser    User           @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  dailyChallenge DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, dailyChallengeId])
  @@index([studentUserId])
  @@map("student_daily_challenges")
}

model StudentPrivacySetting {
  studentUserId           String   @id @map("student_user_id")
  isHiddenFromLeaderboard Boolean  @default(false) @map("is_hidden_from_leaderboard")
  isPrivacyLocked         Boolean  @default(false) @map("is_privacy_locked")
  updatedAt               DateTime @updatedAt @map("updated_at")

  studentUser User @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@map("student_privacy_settings")
}

// ==========================================
// Parent & Teacher Dashboards Models & Enums
// ==========================================

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  OVERDUE
}

enum RiskLevel {
  ON_TRACK
  BEHIND
}

enum RiskReason {
  LOW_ACCURACY
  LOW_ACTIVITY
  OVERDUE_ASSIGNMENT
}

enum AccessType {
  READ_PARENT_DASHBOARD
  READ_CHILD_SUMMARY
  READ_CHILD_ACTIVITIES
  UPDATE_PARENTAL_CONTROLS
  READ_TEACHER_DASHBOARD
  READ_CLASS_STUDENTS
  READ_ITEM_ANALYSIS
  CREATE_ASSIGNMENT
  READ_ASSIGNMENT_PROGRESS
  EXPORT_CLASS_CSV
  READ_WEEKLY_REPORT
}

model ParentalControlSetting {
  id                    String   @id @default(uuid())
  studentUserId         String   @unique @map("student_user_id")
  parentUserId          String   @map("parent_user_id")
  dailyTimeLimitMinutes Int?     @map("daily_time_limit_minutes")
  isPrivacyLocked       Boolean  @default(false) @map("is_privacy_locked")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  studentUser User @relation("StudentParentalSettings", fields: [studentUserId], references: [id], onDelete: Cascade)
  parentUser  User @relation("ParentConfiguredSettings", fields: [parentUserId], references: [id], onDelete: Cascade)

  @@index([parentUserId])
  @@map("parental_control_settings")
}

model LessonAssignment {
  id            String   @id @default(uuid())
  classId       String   @map("class_id")
  teacherUserId String   @map("teacher_user_id")
  lessonId      String   @map("lesson_id")
  title         String
  description   String?  @db.Text
  dueDate       DateTime @map("due_date")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  class             Class                       @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherUser       User                        @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)
  lesson            Lesson                      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentProgresses StudentAssignmentProgress[]

  @@index([classId, dueDate])
  @@index([teacherUserId])
  @@map("lesson_assignments")
}

model StudentAssignmentProgress {
  id            String           @id @default(uuid())
  assignmentId  String           @map("assignment_id")
  studentUserId String           @map("student_user_id")
  status        AssignmentStatus @default(NOT_STARTED)
  score         Int?             @default(0)
  accuracy      Float?           @default(0.0)
  completedAt   DateTime?        @map("completed_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  assignment  LessonAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentUser User             @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentUserId])
  @@index([studentUserId, status])
  @@map("student_assignment_progresses")
}

model WeeklyReportSummary {
  id            String   @id @default(uuid())
  targetUserId  String   @map("target_user_id")
  targetRole    Role     @map("target_role")
  studentUserId String?  @map("student_user_id")
  classId       String?  @map("class_id")
  weekStartDate DateTime @db.Date @map("week_start_date")
  weekEndDate   DateTime @db.Date @map("week_end_date")
  reportDataJson Json    @map("report_data_json")
  createdAt     DateTime @default(now()) @map("created_at")

  targetUser  User  @relation("UserWeeklyReports", fields: [targetUserId], references: [id], onDelete: Cascade)
  studentUser User? @relation("StudentWeeklyReports", fields: [studentUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, weekStartDate])
  @@index([studentUserId])
  @@map("weekly_report_summaries")
}

model StudentDataAccessLog {
  id              String     @id @default(uuid())
  accessorUserId  String     @map("accessor_user_id")
  accessorRole    Role       @map("accessor_role")
  targetStudentId String     @map("target_student_id")
  accessType      AccessType @map("access_type")
  endpoint        String
  ipAddress       String     @map("ip_address")
  userAgent       String     @map("user_agent")
  createdAt       DateTime   @default(now()) @map("created_at")

  accessorUser  User @relation("LogAccessorUser", fields: [accessorUserId], references: [id], onDelete: Cascade)
  targetStudent User @relation("LogTargetStudent", fields: [targetStudentId], references: [id], onDelete: Cascade)

  @@index([targetStudentId, createdAt])
  @@index([accessorUserId, createdAt])
  @@map("student_data_access_logs")
}



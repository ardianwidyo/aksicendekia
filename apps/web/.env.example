# Feature 011 — Focus mode (specs/011-sd-math-focus)
# When true (default if unset), the app restricts stages to SD and subjects to
# Matematika: navigation, search, and catalog entries outside that scope are
# hidden and out-of-focus lesson routes redirect to /explore instead of 404ing.
# Set to "false" to restore every stage/subject with no code change (FR-004).
NEXT_PUBLIC_FOCUS_ENABLED=true
